# Dependencies
node_modules/

# Database and asset backups (at any directory depth)
backup/
backups/
*.dump
*.backup
*.bak
backup-*.sql
before-reset-*.sql
before-user-cleanup-*.sql
backup-*.zip
before-reset-*.zip
before-user-cleanup-*.zip
*-before-webp.zip
*.sql.gz

# Build output and generated TypeScript metadata
dist/
apps/*/dist/
*.tsbuildinfo
*.tsbuildinfo.*

# Environment files and local secrets
.env
.env.*
!.env.example
!**/.env.example

# Test and coverage output
coverage/
.nyc_output/
test-results/
playwright-report/

# Logs and runtime files
*.log
logs/
*.pid
*.pid.lock
*.seed

# Local databases, uploads, and temporary files
*.sqlite
*.sqlite3
*.db
uploads/
# Private operational images: retain structure, never upload customer media to Git.
/storage/private/produk/**/*.webp
tmp/
temp/
.cache/
# Generated reviews/reports are not application source.
/output/

