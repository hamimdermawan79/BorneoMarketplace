# Use this token-file unit OR cloudflared service install, never both.
# Requires cloudflared >= 2025.4.0 from the official apt repository.
# Store a fresh rotated token at /etc/cloudflared/tunnel.token (root:root 0600).
[Unit]
Description=Cloudflare Tunnel For Borneo Marketplace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run --token-file /etc/cloudflared/tunnel.token
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
