# Install the generated .env.cleanup as /etc/borneo-marketplace/cleanup.env,
# root:root 0600. systemd reads this AFTER runtime.env, overriding its reset flag.
ALLOW_DATA_RESET=true
DATA_RESET_DATABASE_URL=postgresql://borneo_cleanup:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/borneo_marketplace
DATA_RESET_BACKUP_DIR=/var/lib/borneo-marketplace/cleanup-backups
PG_DUMP_PATH=/usr/bin/pg_dump
