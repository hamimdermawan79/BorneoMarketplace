# Copy to /etc/borneo-marketplace/runtime.env (root:borneo-api, 0640).
# Use a separate, restricted database login. Never reuse maintenance credentials.
NODE_ENV=production
DATABASE_URL=postgresql://borneo_runtime:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/borneo_marketplace
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=https://REPLACE_WITH_DOMAIN
TRUST_PROXY=loopback
ALLOW_DATA_RESET=false
PRODUCT_STORAGE_DIR=/var/lib/borneo-marketplace/produk
