DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/borneo_marketplace
JWT_SECRET=replace-with-at-least-32-random-characters
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5173
TRUST_PROXY=off
# db:secure generates .env.runtime with a restricted DATABASE_URL for the API.
# Production: set NODE_ENV=production, HTTPS WEB_ORIGIN, and a random JWT_SECRET
# of at least 48 characters. Never give the API migration-owner credentials.
# Set MIGRATION_DATABASE_URL only in a separate maintenance process.
ALLOW_DATA_RESET=false
# Optional superadmin reset (development or production): set ALLOW_DATA_RESET=true
# and DATA_RESET_DATABASE_URL to a privileged connection to the SAME local database.
# Password reauthentication, exact confirmation and a successful backup remain mandatory.
# Keep this credential in server secrets, never in Git or the frontend.
# Set executable path if pg_dump is not on PATH.
PG_DUMP_PATH=pg_dump
# Optional absolute private storage path on VPS (persistent; outside Nginx webroot).
# Default: <repository>/storage/private/produk
# PRODUCT_STORAGE_DIR=/var/lib/borneo-marketplace/produk
