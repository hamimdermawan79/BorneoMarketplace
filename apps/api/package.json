{
  "name": "@borneo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:secure": "tsx src/database/secure.ts",
    "db:bootstrap": "tsx src/database/bootstrap.ts",
    "db:backup": "tsx src/database/backup.ts",
    "test:security": "tsx src/database/security-check.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/jwt": "10.2.2",
    "@fastify/rate-limit": "11.2.0",
    "bcryptjs": "3.0.3",
    "fastify": "5.12.5",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
